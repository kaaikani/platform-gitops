
# Never commit secrets — use AWS Secrets Manager + ExternalSecrets
*-secrets-patch.yaml
*-secrets.yaml
.env
.env.*
*.pem
*.key

# Terraform — never commit state (plaintext secrets), plans, or provider binaries
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
# `terraform plan -out=tfplan` writes a file with NO extension, so *.tfplan
# misses it. The plan file holds every resource attribute -- never commit it.
tfplan
tfplan.*
crash.log
