{
  "title": "Storefronts",
  "description": "Frontend health per storefront — errors, CPU, memory, network, scaling",
  "uid": "storefronts-overview",
  "tags": ["storefront", "frontend", "production"],
  "timezone": "Asia/Kolkata",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "current": { "text": "Prometheus", "value": "prometheus" }, "hide": 0 },
      {
        "name": "namespace", "type": "custom", "hide": 0, "includeAll": false, "multi": false,
        "options": [
          { "selected": true, "text": "storefront-production", "value": "storefront-production" },
          { "selected": false, "text": "southmithai-production", "value": "southmithai-production" },
          { "selected": false, "text": "swadkerala-production", "value": "swadkerala-production" }
        ],
        "query": "storefront-production,southmithai-production,swadkerala-production"
      }
    ]
  },
  "panels": [
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 100, "title": "Health — $namespace", "type": "row" },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 }, "id": 1, "title": "Running Pods", "type": "stat", "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 2 }] } } }, "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }, "targets": [{ "expr": "count(kube_pod_status_phase{namespace=\"$namespace\", phase=\"Running\"} == 1)", "refId": "A" }] },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 }, "id": 2, "title": "Ready Pods", "type": "stat", "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } } }, "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } }, "targets": [{ "expr": "sum(kube_pod_status_ready{namespace=\"$namespace\",condition=\"true\"})", "refId": "A" }] },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 }, "id": 3, "title": "Restarts (24h)", "type": "stat", "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 0, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } } }, "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }, "targets": [{ "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[24h]))", "refId": "A" }] },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 }, "id": 4, "title": "CPU Usage", "type": "gauge", "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }, "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container!=\"\",container!=\"POD\"}[5m])) / sum(kube_pod_container_resource_limits{namespace=\"$namespace\",resource=\"cpu\"})", "refId": "A" }] },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 }, "id": 5, "title": "Memory Usage", "type": "gauge", "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "red", "value": 0.9 }] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }, "targets": [{ "expr": "sum(container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\",container!=\"POD\"}) / sum(kube_pod_container_resource_limits{namespace=\"$namespace\",resource=\"memory\"})", "refId": "A" }] },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 }, "id": 6, "title": "Network In", "type": "stat", "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } }, "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }, "targets": [{ "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"$namespace\"}[5m]))", "refId": "A" }] },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 }, "id": 7, "title": "Network Out", "type": "stat", "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] } } }, "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }, "targets": [{ "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"$namespace\"}[5m]))", "refId": "A" }] },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 }, "id": 8, "title": "HPA Replicas", "type": "stat", "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] }, "decimals": 0 } }, "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } }, "targets": [{ "expr": "sum(kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\"})", "refId": "A" }] },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "id": 200, "title": "Errors & Failures", "type": "row" },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }, "id": 10, "title": "Pod Restarts", "type": "timeseries", "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 30, "lineWidth": 2, "showPoints": "always", "drawStyle": "bars" }, "decimals": 0 } }, "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }, "targets": [{ "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"$namespace\"}[1h])", "legendFormat": "{{pod}}", "refId": "A" }] },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }, "id": 11, "title": "Container Error States", "type": "timeseries", "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "normal" } }, "decimals": 0 } }, "options": { "legend": { "calcs": ["lastNotNull", "sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }, "targets": [{ "expr": "sum(kube_pod_container_status_waiting_reason{namespace=\"$namespace\"}) by (reason)", "legendFormat": "Waiting: {{reason}}", "refId": "A" }, { "expr": "sum(kube_pod_container_status_last_terminated_reason{namespace=\"$namespace\"}) by (reason)", "legendFormat": "Terminated: {{reason}}", "refId": "B" }] },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "id": 300, "title": "CPU & Memory", "type": "row" },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 }, "id": 20, "title": "CPU per Pod (millicores)", "type": "timeseries", "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": ".*limit" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }] }, "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }, "targets": [{ "expr": "rate(container_cpu_usage_seconds_total{namespace=\"$namespace\",container!=\"\",container!=\"POD\"}[5m]) * 1000", "legendFormat": "{{pod}} ({{container}})", "refId": "A" }, { "expr": "kube_pod_container_resource_limits{namespace=\"$namespace\",resource=\"cpu\"} * 1000", "legendFormat": "{{pod}} limit", "refId": "B" }] },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 }, "id": 21, "title": "Memory per Pod", "type": "timeseries", "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": ".*limit" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }] }, "options": { "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }, "targets": [{ "expr": "container_memory_working_set_bytes{namespace=\"$namespace\",container!=\"\",container!=\"POD\"}", "legendFormat": "{{pod}} ({{container}})", "refId": "A" }, { "expr": "kube_pod_container_resource_limits{namespace=\"$namespace\",resource=\"memory\"}", "legendFormat": "{{pod}} limit", "refId": "B" }] },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "id": 400, "title": "Network", "type": "row" },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 }, "id": 30, "title": "Network Bandwidth per Pod", "type": "timeseries", "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" } } }, "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }, "targets": [{ "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"$namespace\"}[5m])) by (pod)", "legendFormat": "{{pod}} rx", "refId": "A" }, { "expr": "-sum(rate(container_network_transmit_bytes_total{namespace=\"$namespace\"}[5m])) by (pod)", "legendFormat": "{{pod}} tx", "refId": "B" }] },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 }, "id": 31, "title": "Network Errors & Drops", "type": "timeseries", "fieldConfig": { "defaults": { "unit": "pps", "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" } } }, "options": { "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }, "targets": [{ "expr": "rate(container_network_receive_errors_total{namespace=\"$namespace\"}[5m])", "legendFormat": "{{pod}} rx errors", "refId": "A" }, { "expr": "rate(container_network_transmit_errors_total{namespace=\"$namespace\"}[5m])", "legendFormat": "{{pod}} tx errors", "refId": "B" }, { "expr": "rate(container_network_receive_packets_dropped_total{namespace=\"$namespace\"}[5m])", "legendFormat": "{{pod}} rx drops", "refId": "C" }] },
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }, "id": 500, "title": "Scaling", "type": "row" },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 }, "id": 40, "title": "HPA Current vs Desired", "type": "timeseries", "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }, "decimals": 0 }, "overrides": [{ "matcher": { "id": "byRegexp", "options": ".*min|.*max" }, "properties": [{ "id": "custom.lineStyle", "value": { "dash": [5, 5], "fill": "dash" } }] }] }, "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }, "targets": [{ "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"$namespace\"}", "legendFormat": "current", "refId": "A" }, { "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"$namespace\"}", "legendFormat": "desired", "refId": "B" }, { "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"$namespace\"}", "legendFormat": "min", "refId": "C" }, { "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"$namespace\"}", "legendFormat": "max", "refId": "D" }] },
    { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 }, "id": 41, "title": "CPU Throttling %", "type": "timeseries", "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 20, "lineWidth": 2, "showPoints": "never" }, "min": 0, "max": 100 } }, "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }, "targets": [{ "expr": "sum(increase(container_cpu_cfs_throttled_periods_total{namespace=\"$namespace\",container!=\"\",container!=\"POD\"}[5m])) by (pod) / sum(increase(container_cpu_cfs_periods_total{namespace=\"$namespace\",container!=\"\",container!=\"POD\"}[5m])) by (pod) * 100", "legendFormat": "{{pod}}", "refId": "A" }] }
  ]
}
